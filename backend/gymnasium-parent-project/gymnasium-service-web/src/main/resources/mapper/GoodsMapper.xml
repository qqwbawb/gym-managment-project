<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xq.web.goods.mapper.GoodsMapper">

    <!--
        库存原子扣减：判断条件直接写在 WHERE 里，判断与扣减在同一条 SQL 内完成，
        由 InnoDB 行锁保证原子性，避免"先查后改"的并发窗口（超卖）。
        返回影响行数：1 = 扣减成功；0 = 库存不足或商品不存在。
    -->
    <update id="subStore">
        update goods
        set store = store - #{num}
        where goods_id = #{goodsId} and store &gt;= #{num}
    </update>

    <!-- 库存回补（订单取消 / 退货场景） -->
    <update id="addStore">
        update goods
        set store = store + #{num}
        where goods_id = #{goodsId}
    </update>

    <!--
        悲观锁查询：SELECT ... FOR UPDATE 锁定该商品行，后续在同一事务内可放心
        做复杂判断（如库存 + 限购 + 会员等级的联合校验）。
        与上面的原子扣减互为补充：单字段计数器用原子操作，多条件联合校验用悲观锁。
    -->
    <select id="getGoodsForUpdate" resultType="com.xq.web.goods.entity.Goods">
        select goods_id, name, details, image, unit, specs, price, store
        from goods
        where goods_id = #{goodsId}
        for update
    </select>

</mapper>